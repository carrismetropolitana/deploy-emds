{
  "name": "deploy-emds",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/server"
  ],
  "scripts": {
    "build": "npm run build --workspace @carrismetropolitana/deploy-emds-server",
    "check": "npm run typecheck && npm run build",
    "db:tunnel": "npm run db:tunnel --workspace @carrismetropolitana/deploy-emds-server",
    "dev": "npm run dev --workspace @carrismetropolitana/deploy-emds-server",
    "repo:rinse": "npx --yes @tmlmobilidade/repo-rinse",
    "start": "npm run start --workspace @carrismetropolitana/deploy-emds-server",
    "typecheck": "npm run typecheck --workspace @carrismetropolitana/deploy-emds-server"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
