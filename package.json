{
  "name": "@carrismetropolitana/deploy-emds",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "check": "npm run typecheck && npm run build",
    "db:tunnel": "dotenv-run -f ./environments/development/secrets/.env -- turbo run db:tunnel --filter=@carrismetropolitana/deploy-emds-api",
    "dev": "npm run dev:api",
    "dev:api": "dotenv-run -f ./environments/development/secrets/.env -- turbo run dev --filter=@carrismetropolitana/deploy-emds-api",
    "rinse": "npx --yes @tmlmobilidade/repo-rinse",
    "start": "npm run start --workspace @carrismetropolitana/deploy-emds-api",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@dotenv-run/cli": "^1.3.6",
    "turbo": "^2.9.6"
  },
  "packageManager": "npm@11.11.0",
  "workspaces": [
    "apps/*"
  ]
}
