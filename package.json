{
  "name": "deploy-emds-public-api",
  "version": "1.0.0",
  "private": true,
  "description": "Public streaming API for DeployEMDS road-link datasets",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:tunnel": "node --env-file=.env --import tsx src/tunnel.ts",
    "dev": "node --env-file=.env --import tsx src/launcher.ts --watch",
    "start": "node --env-file=.env --enable-source-maps dist/launcher.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    
    "repo:rinse": "npx --yes @tmlmobilidade/repo-rinse"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/swagger": "^9.8.1",
    "fastify": "^5.10.0",
    "pg": "^8.22.0",
    "pg-copy-streams": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/pg-copy-streams": "^1.2.5",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
