{
  "name": "@carrismetropolitana/deploy-emds-api",
  "version": "1.0.0",
  "private": true,
  "description": "Public streaming API for DeployEMDS road-link datasets",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "dev": "node --import tsx src/launcher.ts --watch",
    "start": "node --enable-source-maps dist/launcher.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fast-csv/parse": "^5.0.7",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/swagger": "^9.8.1",
    "@tmlmobilidade/sqlite": "20260803.15.9",
    "@tmlmobilidade/ssh": "20260730.1037.5",
    "@tmlmobilidade/writers": "20260803.15.9",
    "archiver": "^8.0.0",
    "fastify": "^5.10.0",
    "pg": "^8.22.0",
    "pg-copy-streams": "^7.0.0"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/pg-copy-streams": "^1.2.5",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
