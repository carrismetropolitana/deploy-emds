{
  "name": "@carrismetropolitana/deploy-emds-api",
  "version": "1.0.0",
  "private": true,
  "description": "Public streaming API for DeployEMDS road-link datasets",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "db:tunnel": "node --import tsx src/ssh/tunnel.ts",
    "dev": "node --import tsx src/launcher.ts --watch",
    "start": "node --enable-source-maps dist/launcher.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/swagger": "^9.8.1",
    "fastify": "^5.10.0",
    "pg": "^8.22.0",
    "pg-copy-streams": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/pg-copy-streams": "^1.2.5",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
